rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ==================================================================================
       HELPER FUNCTIONS
       ================================================================================== */

    function isSignedIn() {
      return request.auth != null;
    }

    // Email is a public, mutable identifier — this is a known limitation
    // (AR-02/F-137) until admin authority moves to a Firebase custom claim
    // or allowlisted-UID role document administered by trusted server-side
    // tooling. Requiring email_verified at least prevents an unverified
    // account from claiming admin authority by setting an unconfirmed email.
    function isAdmin() {
      // .get() with a default avoids relying on absent-claim behavior for a
      // caller whose token has no `email` field at all (see the same
      // isAdmin() in storage.rules, where the equivalent bare-property
      // access throws instead of evaluating to false).
      return isSignedIn()
        && request.auth.token.get('email', null) == 'arkkahdarkkahd@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    // Trip Cost
    function isTripCostParticipant(tripId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/artifacts/trip-cost/trips/$(tripId)).data.participantIds;
    }

    // Trip Planner
    function isTripPlannerParticipant(plannerId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/artifacts/trip-planner/planners/$(plannerId)).data.participantUids;
    }

    // Date Night
    function isDateNightParticipant() {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/artifacts/date-night/couples/main).data.participantUids;
    }

    // Trip Cost field update guard
    function allowedTripCostTopLevelUpdate() {
      let allowed = ['participants', 'participantIds', 'expenses', 'payments', 'updatedAt', 'name'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }


    // Conflict Tracker: member of a tracker (by UID or invited email)
    function isConflictTrackerMember(trackerId) {
      let tracker = get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)).data;
      return isSignedIn() && (
        request.auth.uid in tracker.memberUids ||
        (tracker.memberEmails != null && request.auth.token.get('email', '').lower() in tracker.memberEmails)
      );
    }

    // Conflict Tracker: creator or Person A (the roles the UI already treats
    // as the shared-section/deletion authority — now rules-enforced, AR-03/F-037).
    function isConflictCreatorOrPersonA(trackerId) {
      let tracker = get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)).data;
      return isSignedIn() && (request.auth.uid == tracker.createdBy || request.auth.uid == tracker.personAUid);
    }

    function ownsConflictSide(trackerId, side) {
      let tracker = get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)).data;
      return isSignedIn() && (
        (side == 'personA' && request.auth.uid == tracker.personAUid) ||
        (side == 'personB' && request.auth.uid == tracker.get('personBUid', null))
      );
    }

    function validConflictSubmission(trackerId, conflictId, side, submittedAt) {
      let reflection = getAfter(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)/conflicts/$(conflictId)/reflections/$(side)).data;
      return submittedAt is timestamp && submittedAt == reflection.submittedAt
        && reflection.authorUid == request.auth.uid && reflection.id == side
        && reflection.person == side && reflection.conflictId == conflictId;
    }

    // Conflict Tracker: true once both sides have a genuinely *submitted*
    // (not draft) reflection, per the conflict doc's server-validated mirror
    // fields (see the conflicts match block below) — the only signal the
    // pre-reveal reflection read rule and the SharedSection UI gate trust
    // (AR-03/F-036/F-069).
    function conflictBothSubmitted(trackerId, conflictId) {
      let c = get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)/conflicts/$(conflictId)).data;
      return c.get('personASubmittedAt', null) is timestamp
        && c.get('personBSubmittedAt', null) is timestamp;
    }

		// Show Tracker: member of a list
    function isShowsListMember(listId) {
      return isSignedIn() && listId != null &&
        request.auth.uid in get(/databases/$(database)/documents/artifacts/shows/lists/$(listId)).data.memberUids;
    }

    // Show Tracker: admin of a list (site admin OR list-level admin)
    function isShowsListAdmin(listId) {
      return isAdmin() ||
        (isSignedIn() && listId != null &&
        request.auth.uid in get(/databases/$(database)/documents/artifacts/shows/lists/$(listId)).data.adminUids);
    }

    /* ==================================================================================
       CALORIE TRACKER (LEGACY)
       ================================================================================== */

    // Pinned to the literal `default-app-id` namespace (the actual runtime
    // fallback CalorieTracker uses — see F-141) instead of a wildcard
    // `{appId}` segment, so a future per-user tool placed under
    // /artifacts/{anything}/users/{uid}/** does not become writable before
    // its own validation rules are designed (AR-02/F-138).
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // #61 source only, pending Part B deployment. The named first segment
    // prevents recursive grants from bypassing the immutable collections.
    match /artifacts/default-app-id/users/{userId}/{collectionName}/{subpath=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && !(collectionName in [
        'ingredientIdentities', 'ingredientVariants', 'ingredientRevisions', 'ingredientConversions'
      ]);
    }

    function ingredientBase(d, userId) {
      return isOwner(userId) && d.schemaVersion == 1 && d.ownerUid == userId;
    }
    function ingredientHash(hash) { return hash is string && hash.matches('sha256:[a-f0-9]{64}'); }
    function ingredientVariant(userId, variantId) {
      return /databases/$(database)/documents/artifacts/default-app-id/users/$(userId)/ingredientVariants/$(variantId);
    }
    function ingredientRevision(userId, revisionId) {
      return /databases/$(database)/documents/artifacts/default-app-id/users/$(userId)/ingredientRevisions/$(revisionId);
    }
    match /artifacts/default-app-id/users/{userId}/ingredientIdentities/{identityId} {
      function validIdentity(d) {
        return ingredientBase(d, userId) && d.identityId == identityId
          && identityId.matches('pi-[a-f0-9]{20}')
          && d.keys().hasOnly(['schemaVersion','ownerUid','identityId','identityKeyV1','canonicalName','category','kind','aliases','searchTokens','createdAt','updatedAt','retiredAt'])
          && d.identityKeyV1 is string && d.identityKeyV1.size() <= 1000
          && d.canonicalName is string && d.canonicalName.size() > 0 && d.canonicalName.size() <= 200
          && d.category is string && d.kind is string
          && d.aliases is list && d.aliases.size() <= 64
          && d.searchTokens is list && d.searchTokens.size() <= 64;
      }
      allow create: if validIdentity(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.retiredAt == null;
      allow update: if validIdentity(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canonicalName','aliases','searchTokens','updatedAt','retiredAt'])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.retiredAt == null || request.resource.data.retiredAt is timestamp);
      allow delete: if false;
    }
    match /artifacts/default-app-id/users/{userId}/ingredientVariants/{variantId} {
      function validVariant(d) {
        return ingredientBase(d,userId) && d.variantId == variantId
          && d.keys().hasOnly(['schemaVersion','ownerUid','identityId','variantId','variantKeyV1','dims','overrides','headRevision','headRevisionId','headContentHash','createdAt','updatedAt','retiredAt'])
          && d.identityId is string && d.variantKeyV1 is string && d.variantKeyV1.size() <= 4000
          && d.dims is map && d.dims.size() <= 12
          && d.headRevision is int && d.headRevision >= 1
          && d.headRevisionId == variantId + '~r' + string(d.headRevision)
          && ingredientHash(d.headContentHash);
      }
      function validLink(d) {
        return d.overrides != null
          ? (variantId.matches('ov-[a-f0-9]{20}') && d.overrides is map
            && d.overrides.keys().hasOnly(['catalogId','variantId','revision'])
            && d.overrides.catalogId == 'nutrition-curated'
            && d.overrides.variantId is string && d.overrides.variantId.matches('[a-z0-9]+(-[a-z0-9]+)*')
            && d.overrides.revision is int && d.overrides.revision >= 1)
          : (variantId.matches('pv-[a-f0-9]{20}') && d.identityId.matches('pi-[a-f0-9]{20}')
            && existsAfter(/databases/$(database)/documents/artifacts/default-app-id/users/$(userId)/ingredientIdentities/$(d.identityId)));
      }
      function validHead(d) {
        let revision = getAfter(ingredientRevision(userId,d.headRevisionId)).data;
        return revision.variantId == variantId && revision.identityId == d.identityId
          && revision.ownerUid == userId && revision.revision == d.headRevision
          && revision.contentHash == d.headContentHash;
      }
      allow create: if validVariant(request.resource.data) && validLink(request.resource.data)
        && request.resource.data.headRevision == 1 && validHead(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.retiredAt == null;
      allow update: if validVariant(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.retiredAt == null || request.resource.data.retiredAt is timestamp)
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['headRevision','headRevisionId','headContentHash','updatedAt'])
            && request.resource.data.headRevision == resource.data.headRevision + 1
            && validHead(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retiredAt','updatedAt'])
            && request.resource.data.headRevision == resource.data.headRevision
            && request.resource.data.headRevisionId == resource.data.headRevisionId
            && request.resource.data.headContentHash == resource.data.headContentHash)
        );
      allow delete: if false;
    }
    match /artifacts/default-app-id/users/{userId}/ingredientRevisions/{revisionId} {
      function validSupersedes(d) {
        let previousId = d.variantId + '~r' + string(d.revision - 1);
        return d.revision == 1 ? d.supersedes == null : (
          d.supersedes is map && d.supersedes.keys().hasOnly(['revision','revisionId','contentHash'])
          && d.supersedes.revision == d.revision - 1 && d.supersedes.revisionId == previousId
          && d.supersedes.contentHash == get(ingredientRevision(userId,previousId)).data.contentHash
          && get(ingredientVariant(userId,d.variantId)).data.headRevision == d.revision - 1
        );
      }
      function validRevision(d) {
        let head = getAfter(ingredientVariant(userId,d.variantId)).data;
        return ingredientBase(d,userId)
          && d.keys().hasOnly(['schemaVersion','ownerUid','identityId','variantId','basis','nutrients','nutrientMeta','fieldProvenance','sources','basedOn','supersedes','contentHash','revision','revisionId','idempotencyKey','createdAt'])
          && d.revision is int && d.revision >= 1 && d.revisionId == revisionId
          && revisionId == d.variantId + '~r' + string(d.revision)
          && d.identityId == head.identityId && head.headRevisionId == revisionId
          && head.headRevision == d.revision && head.headContentHash == d.contentHash
          && ingredientHash(d.contentHash) && d.idempotencyKey is string && d.idempotencyKey.size() <= 100
          && d.basis is map && d.basis.keys().hasOnly(['kind','state'])
          && d.basis.kind == 'per_100g_edible' && d.basis.state is string
          && d.nutrients is map && d.nutrients.size() <= 68
          && d.nutrientMeta is map && d.nutrientMeta.registryVersion == 2
          && d.fieldProvenance is map && d.fieldProvenance.size() <= 68
          && d.sources is map && d.sources.size() <= 64
          && d.createdAt == request.time && validSupersedes(d);
      }
      allow create: if validRevision(request.resource.data);
      allow update, delete: if false;
    }
    match /artifacts/default-app-id/users/{userId}/ingredientConversions/{conversionId} {
      function validConversion(d) {
        return ingredientBase(d,userId) && d.conversionId == conversionId && conversionId.matches('pc-[a-f0-9]{20}')
          && d.keys().hasOnly(['schemaVersion','ownerUid','conversionId','variantRef','kind','unit','unitQualifier','amount','grams','gramsPerMl','state','source','confidence','range','supersedes','createdAt'])
          && d.variantRef is map && d.variantRef.refVersion == 1 && d.variantRef.scope == 'private'
          && d.variantRef.namespace == 'default-app-id'
          && d.variantRef.keys().hasOnly(['refVersion','scope','namespace','identityId','variantId','revision','revisionId','contentHash'])
          && d.variantRef.revision is int && d.variantRef.revision >= 1
          && d.variantRef.revisionId == d.variantRef.variantId + '~r' + string(d.variantRef.revision)
          && getAfter(ingredientRevision(userId,d.variantRef.revisionId)).data.variantId == d.variantRef.variantId
          && getAfter(ingredientRevision(userId,d.variantRef.revisionId)).data.identityId == d.variantRef.identityId
          && existsAfter(ingredientVariant(userId,d.variantRef.variantId))
          && getAfter(ingredientRevision(userId,d.variantRef.revisionId)).data.contentHash == d.variantRef.contentHash
          && d.kind in ['household','density','piece','package'] && d.unit is string && d.unit.size() <= 80
          && d.amount is number && d.amount > 0 && d.amount <= 1000000
          && (d.kind == 'density' ? (d.unit == 'mL' && d.gramsPerMl is number && d.gramsPerMl > 0 && d.gramsPerMl <= 100)
             : (d.grams is number && d.grams > 0 && d.grams <= 1000000))
          && d.state is string && d.source is map && d.source.size() <= 20
          && d.source.type in ['fdc','label','manufacturer','manual','comparable','legacy_food','curated_catalog']
          && d.confidence is number && d.confidence >= 0 && d.confidence <= 1
          && d.createdAt == request.time;
      }
      allow create: if validConversion(request.resource.data);
      allow update, delete: if false;
    }

    /* ==================================================================================
       TRIP COST TOOL
       ================================================================================== */

    match /artifacts/trip-cost/users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    match /artifacts/trip-cost/trips/{tripId} {
      allow read: if isAdmin() || isTripCostParticipant(tripId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTripCostParticipant(tripId) && allowedTripCostTopLevelUpdate());
    }

    match /artifacts/trip-cost/trips/{tripId}/audit/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /artifacts/trip-cost/trips/{tripId}/expenses/{expenseId} {
      allow read: if isAdmin() || isTripCostParticipant(tripId);
      allow create: if isTripCostParticipant(tripId) && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin() || (isTripCostParticipant(tripId) && resource.data.createdBy == request.auth.uid);
    }

    match /artifacts/trip-cost/trips/{tripId}/payments/{paymentId} {
      allow read: if isAdmin() || isTripCostParticipant(tripId);
      allow create: if isTripCostParticipant(tripId) && request.resource.data.payerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isTripCostParticipant(tripId) && resource.data.payerId == request.auth.uid);
    }

    /* ==================================================================================
       TRIP PLANNER TOOL
       ================================================================================== */

    match /artifacts/trip-planner/planners/{plannerId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participantUids);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['ownerUid', 'participantUids'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.participantUids.size() == 1
        && request.resource.data.participantUids[0] == request.auth.uid;

      allow update: if
        isAdmin()
        || (isSignedIn()
            && request.auth.uid in resource.data.participantUids
            && !request.resource.data.diff(resource.data).changedKeys().hasAny(['ownerUid', 'participantUids', 'costTrackerId'])
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'startDate', 'endDate', 'timezone', 'settings', 'updatedAt']))
        || (isSignedIn()
            && request.auth.uid == resource.data.ownerUid
            && !request.resource.data.diff(resource.data).changedKeys().hasAny(['ownerUid'])
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
                'name', 'startDate', 'endDate', 'timezone', 'settings', 'updatedAt',
                'participantUids', 'participants', 'lastModifiedBy', 'costTrackerId'
            ]));

      allow delete: if isAdmin();
    }

    match /artifacts/trip-planner/planners/{plannerId}/events/{eventId} {
      allow read: if isAdmin() || isTripPlannerParticipant(plannerId);
      allow create, update, delete: if isAdmin() || isTripPlannerParticipant(plannerId);
    }

    match /artifacts/trip-planner/planners/{plannerId}/activityIdeas/{ideaId} {
      allow read: if isAdmin() || isTripPlannerParticipant(plannerId);
      allow create, update, delete: if isAdmin() || isTripPlannerParticipant(plannerId);
    }

    match /artifacts/trip-planner/planners/{plannerId}/changelog/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    /* ==================================================================================
       DATE NIGHT ROULETTE TOOL
       ================================================================================== */

    match /artifacts/date-night/couples/{coupleId} {
      allow read: if isAdmin() || isDateNightParticipant();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/date-night/settings/{settingId} {
      allow read, write: if isAdmin() || isDateNightParticipant();
    }

    match /artifacts/date-night/dates/{docId} {
      allow read, create, update, delete: if isAdmin() || isDateNightParticipant();
    }

    match /artifacts/date-night/modifiers/{docId} {
      allow read, create, update, delete: if isAdmin() || isDateNightParticipant();
    }

    match /artifacts/date-night/rolls/{docId} {
      allow read, create, update, delete: if isAdmin() || isDateNightParticipant();
    }

    /* ==================================================================================
       CONFLICT TRACKER TOOL
       ================================================================================== */

		match /artifacts/conflict-tracker/trackers/{trackerId} {
      // Read directly evaluates resource.data to allow collection queries to succeed
      allow read: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid in resource.data.memberUids ||
          (resource.data.memberEmails != null && request.auth.token.get('email', '').lower() in resource.data.memberEmails)
        )
      );

      allow create: if isSignedIn()
        && request.resource.data.personAUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.personBUid == null
        // Creation cannot pre-seat hidden observers: the only members are the
        // creator's UID and, optionally, the normalized Person B invite email.
        && request.resource.data.memberUids == [request.auth.uid]
        && (request.resource.data.get('personBEmail', null) == null
          ? request.resource.data.get('memberEmails', []) == []
          : (request.resource.data.personBEmail is string
            && request.resource.data.personBEmail == request.resource.data.personBEmail.lower()
            && request.resource.data.get('memberEmails', []) == [request.resource.data.personBEmail]));

      // Was: any member could rewrite every field (membership, side UIDs,
      // creator) with no restriction (F-037). Now split into two narrow,
      // non-overlapping transitions:
      allow update: if isAdmin()
        // (1) Person A may rename the tracker / edit custom tags — never
        //     membership or side-identity fields.
        || (isSignedIn()
            && request.auth.uid == resource.data.personAUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'customTags', 'updatedAt']))
        // (1b) Any claimed member may add tracker custom tags (the conflict
        //      form calls addCustomTag for whoever creates the conflict).
        || (isSignedIn()
            && request.auth.uid in resource.data.memberUids
            && request.resource.data.customTags is list
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customTags', 'updatedAt']))
        // (2) Person B claim: a one-time personBUid null -> caller transition,
        //     gated on the caller's email matching the invitation (F-071).
        //     No email_verified requirement yet — this app has no
        //     verification-email flow for ordinary (non-admin) users; see
        //     AR-03 follow-up in backlogs/audit-remediation.md.
        || (isSignedIn()
            && resource.data.personBUid == null
            && request.resource.data.personBUid == request.auth.uid
            && resource.data.personBEmail != null
            && request.auth.token.get('email', '').lower() == resource.data.personBEmail
            && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personBUid', 'memberUids', 'updatedAt']));

      // Was: any member. Deletion is a Person A/admin action in the UI
      // already (F-074) — now rules-enforced to match.
      allow delete: if isAdmin() || isConflictCreatorOrPersonA(trackerId);
    }

    match /artifacts/conflict-tracker/trackers/{trackerId}/conflicts/{conflictId} {
      allow read: if isAdmin() || isConflictTrackerMember(trackerId);

      allow create: if isConflictTrackerMember(trackerId)
        && request.resource.data.createdBy == request.auth.uid
        // .get(): the pre-AR-03 client omits the mirrors on create; a missing
        // field must read as null rather than erroring the whole rule.
        && request.resource.data.get('personASubmittedAt', null) == null
        && request.resource.data.get('personBSubmittedAt', null) == null
        // A new conflict starts unresolved, without reflections and without
        // a shared section, so creation cannot bypass the role-scoped update
        // paths below (e.g. Person B pre-setting personAResolved). Missing
        // fields (older client shapes) read as their defaults.
        && request.resource.data.get('personAResolved', false) == false
        && request.resource.data.get('personBResolved', false) == false
        && request.resource.data.get('status', 'open') == 'open'
        && request.resource.data.get('hasReflectionA', false) == false
        && request.resource.data.get('hasReflectionB', false) == false
        && !request.resource.data.keys().hasAny([
            'personARealMeaning', 'personBRealMeaning', 'sharedClarification',
            'sharedOwnershipNotes', 'sharedNextSteps', 'sharedUpdatedBy', 'sharedUpdatedAt'
          ]);

      // Every update path is field-scoped; there is no general "member can
      // edit everything" fallback (F-037/F-072).
      allow update: if isAdmin() || (isConflictTrackerMember(trackerId) && (
        // (1) Ordinary content edits — creator/Person A only (matches the
        //     existing edit-conflict UI, now enforced).
        (isConflictCreatorOrPersonA(trackerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'date', 'severity', 'tags', 'summary', 'updatedAt']))
        // (2) Shared section — creator/Person A only (matches
        //     assertSharedSectionEditor in ConflictContext.tsx), and only
        //     once both sides have genuinely submitted (F-069: this was
        //     previously gated on client-only hasReflectionA/B draft flags).
        || (isConflictCreatorOrPersonA(trackerId)
          && resource.data.get('personASubmittedAt', null) is timestamp && resource.data.get('personBSubmittedAt', null) is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'personARealMeaning', 'personBRealMeaning', 'sharedClarification',
              'sharedOwnershipNotes', 'sharedNextSteps', 'sharedUpdatedBy', 'sharedUpdatedAt', 'updatedAt'
            ])
          && request.resource.data.get('sharedUpdatedBy', null) == request.auth.uid)
        // (3) Draft-exists flag and/or submitted mirror, together or
        //     separately, for the acting side's own author only:
        //       - hasReflectionX can only be set true, never reset false
        //         (matches saveReflectionDraft/submitReflection);
        //       - personXSubmittedAt can only go null -> the exact value
        //         present on that side's own reflection after the atomic write,
        //         never reset (no unsubmitting — F-036/F-069/F-073). This
        //         can't be forged independent of an actual submission
        //         because the value must match the reflection doc exactly.
        || (request.auth.uid == get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)).data.personAUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasReflectionA', 'personASubmittedAt', 'updatedAt'])
          && (!('hasReflectionA' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.hasReflectionA == true)
          && (!('personASubmittedAt' in request.resource.data.diff(resource.data).affectedKeys())
              || (resource.data.get('personASubmittedAt', null) == null
                  && validConflictSubmission(trackerId, conflictId, 'personA', request.resource.data.personASubmittedAt))))
        || (request.auth.uid == get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)).data.personBUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasReflectionB', 'personBSubmittedAt', 'updatedAt'])
          && (!('hasReflectionB' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.hasReflectionB == true)
          && (!('personBSubmittedAt' in request.resource.data.diff(resource.data).affectedKeys())
              || (resource.data.get('personBSubmittedAt', null) == null
                  && validConflictSubmission(trackerId, conflictId, 'personB', request.resource.data.personBSubmittedAt))))
        // (4) Resolution — each side may only set their own resolved flag;
        //     status must be the value that flag combination derives to
        //     (F-072: previously any member could flip either side).
        || (request.auth.uid == get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)).data.personAUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personAResolved', 'status', 'updatedAt'])
          && request.resource.data.status == (
              request.resource.data.personAResolved && resource.data.personBResolved ? 'resolved'
              : (request.resource.data.personAResolved || resource.data.personBResolved ? 'partially_resolved' : 'open')))
        || (request.auth.uid == get(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)).data.personBUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personBResolved', 'status', 'updatedAt'])
          && request.resource.data.status == (
              resource.data.personAResolved && request.resource.data.personBResolved ? 'resolved'
              : (resource.data.personAResolved || request.resource.data.personBResolved ? 'partially_resolved' : 'open')))
      ));

      // Was: any member. Matches Person A/admin deletion authority (F-074).
      allow delete: if isAdmin() || isConflictCreatorOrPersonA(trackerId);
    }

    match /artifacts/conflict-tracker/trackers/{trackerId}/conflicts/{conflictId}/reflections/{side} {
      // Own draft/submission is always visible to its author; a partner's
      // reflection is only visible once BOTH sides have genuinely submitted
      // (F-036: previously any tracker member could read both reflections
      // at any time, including unsubmitted drafts).
      allow get: if isAdmin()
        || (isConflictTrackerMember(trackerId) && ownsConflictSide(trackerId, side)
          && (!exists(/databases/$(database)/documents/artifacts/conflict-tracker/trackers/$(trackerId)/conflicts/$(conflictId)/reflections/$(side))
            || resource.data.authorUid == request.auth.uid))
        || (isConflictTrackerMember(trackerId) && conflictBothSubmitted(trackerId, conflictId));
      allow list: if isAdmin()
        || (isConflictTrackerMember(trackerId) && conflictBothSubmitted(trackerId, conflictId));

      function validIdentity() {
        return request.resource.data.id == side
          && request.resource.data.person == side
          && request.resource.data.conflictId == conflictId
          && request.resource.data.authorUid == request.auth.uid;
      }

      // Admin keeps read/delete/parent override authority, but cannot impersonate
      // an assigned author. Creating/editing a reflection requires that side's UID.
      allow create: if isConflictTrackerMember(trackerId)
        && ownsConflictSide(trackerId, side) && validIdentity()
        && (request.resource.data.submittedAt == null || request.resource.data.submittedAt is timestamp);

      allow update: if isConflictTrackerMember(trackerId)
        && ownsConflictSide(trackerId, side) && validIdentity()
        && resource.data.authorUid == request.auth.uid
        && (resource.data.get('submittedAt', null) == null
          ? (request.resource.data.submittedAt == null || request.resource.data.submittedAt is timestamp)
          : request.resource.data.submittedAt == resource.data.submittedAt);

      // Matches conflict-level deletion authority (F-074) so deleteConflict's
      // batch can remove reflections and the conflict together.
      allow delete: if isAdmin() || isConflictCreatorOrPersonA(trackerId);
    }

    /* ==================================================================================
       RECIPE STANDARDIZER TOOL
       ================================================================================== */

    // Recipes are private per-user documents:
    //   artifacts/recipe-standardizer/users/{uid}/recipes/{recipeId}
    // The legacy CalorieTracker wildcard above already permits this path, but this
    // explicit block keeps the tool working if that legacy rule is ever tightened.
    match /artifacts/recipe-standardizer/users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    /* ==================================================================================
       SHOW TRACKER
       ================================================================================== */

    // Lists
    match /artifacts/shows/lists/{listId} {
      // Read: any member
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.memberUids);

      // Create: any authed user; must set themselves as owner, member, and admin
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.uid in request.resource.data.adminUids;

      // Update: admins freely; OR self-add via invite; OR member updating own display name
      allow update: if isAdmin()
        || isShowsListAdmin(listId)
        // Self-add via invite flow (only allowed change: adding self to members + memberUids)
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids', 'updatedAt'])
            && request.auth.uid in request.resource.data.memberUids
            && !(request.auth.uid in resource.data.memberUids))
        // Member updating their own display name in the memberDisplayNames map.
        // MapDiff.affectedKeys() verifies only the caller's UID key changed — unlike
        // array diffs, Firestore can enforce per-key ownership on map fields.
        || (isSignedIn()
            && request.auth.uid in resource.data.memberUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberDisplayNames', 'updatedAt'])
            && request.resource.data.memberDisplayNames.diff(resource.data.get('memberDisplayNames', {})).affectedKeys().hasOnly([request.auth.uid]));

      // Delete: list admin only
      allow delete: if isAdmin() || isShowsListAdmin(listId);
    }

    // Shows
    match /artifacts/shows/shows/{showId} {
      allow read: if isAdmin() || isShowsListMember(resource.data.listId);
      allow create: if isShowsListMember(request.resource.data.listId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || isShowsListMember(resource.data.listId);
      allow delete: if isAdmin() || isShowsListAdmin(resource.data.listId);
    }

    // Pending invites
    match /artifacts/shows/pendingInvites/{inviteId} {
      // Read: site admin, or the invited user (for self-processing on sign-in)
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.email == request.auth.token.email);

      // Create: only list admins can invite
      allow create: if isShowsListAdmin(request.resource.data.listId);

      // Delete: site admin, list admin, or the invited user consuming their own invite
      allow delete: if isAdmin()
        || isShowsListAdmin(resource.data.listId)
        || (isSignedIn() && resource.data.email == request.auth.token.email);

      allow update: if false;
    }

  }
}
