{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker for jamesberto.com after the next-on-pages -> OpenNext
  // migration (AR-01). Account: 1fe4f24f7aea01cf86064202b557b79f.
  //
  // Until cutover, this Worker is served ONLY on its workers.dev preview URL.
  // The live site (jamesberto.com, www.jamesberto.com) stays on the Pages
  // project `weekendtrip`. Do not add `routes` / custom domains here until
  // the cutover in README.md "Deployment" is approved.
  "name": "jamesberto-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jamesberto-website"
    }
  ]
  // Secrets (GEMINI_API_KEY, GPT_API_KEY, TMDB_API_KEY, TMDB_READ_ACCESS_TOKEN)
  // are set via `wrangler secret put <NAME>` against the deployed Worker,
  // never committed here. They use the same names as the Pages project, so
  // no code changes are needed when they are copied over.
}
